# Copy this file to .env and fill in your own values:  cp .env.example .env
# .env is in .gitignore, so your secrets are never committed.

# OpenAI key, used by every LLM call (utils/llm_pick.py)
OPENAI_API_KEY=sk-your-key-here

# PostgreSQL connection (feed_db.py and the SQL Analyst)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password-here

# Only used by the self-test at the bottom of utils/etl_tools.py
PATH_DATA_EXTRACTED=data/extracted/
